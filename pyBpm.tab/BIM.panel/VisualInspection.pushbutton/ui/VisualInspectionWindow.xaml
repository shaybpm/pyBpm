<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BPM - בדיקה ויזואלית Arc-Const"
        MinHeight="400"
        MinWidth="800"
        Height="780"
        Width="1180"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        FlowDirection="LeftToRight">

    <!-- Button styles are duplicated in VisualInspectionRowPage.xaml: a Page
         inside a Frame does not see the Window's resources, and the row buttons
         resolve their style at parse time. Keep the two copies in step. -->
    <Window.Resources>
        <Style x:Key="FlatButtonBase" TargetType="Button">
            <Setter Property="Foreground" Value="#2B2B2B" />
            <Setter Property="Background" Value="#F4F5F7" />
            <Setter Property="BorderBrush" Value="#CFD3DA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="5"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E6F0FB" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#5B9BD5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#CFE2F5" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3A7CBD" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#F0F0F0" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#E2E2E2" />
                                <Setter Property="Foreground" Value="#AAAAAA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource FlatButtonBase}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource FlatButtonBase}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="14,0,14,0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Margin="4">
        <Border Margin="4" BorderBrush="Gray" BorderThickness="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Header: the model's score, and when it was measured -->
                <Border Grid.Row="0" Grid.ColumnSpan="3" BorderThickness="0,0,0,1"
                        BorderBrush="Gray">
                    <Grid Margin="10,6,10,6" FlowDirection="RightToLeft">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ציון המודל" FontSize="11" Foreground="Gray" />
                            <TextBlock x:Name="model_score_text" Text="—"
                                       FontSize="30" FontWeight="Bold" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="comp_model_text" FontWeight="Bold"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="run_date_text" Foreground="Gray"
                                       Margin="0,2,0,0" />
                            <TextBlock x:Name="source_note_text" Foreground="DarkOrange"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>

                        <Button Grid.Column="2" x:Name="refresh_btn" Content="&#x21BB;"
                                VerticalAlignment="Center"
                                Style="{StaticResource IconButton}"
                                ToolTip="קורא מחדש את מודל הקומפילציה ואת הציונים, ומעדכן אילו מבטים כבר קיימים אצלך."
                                Click="refresh_btn_Click" />
                    </Grid>
                </Border>

                <!-- Navigation: one button per row (sheet), worst score first -->
                <Grid Grid.Row="1" Grid.Column="0" MinWidth="200"
                      FlowDirection="RightToLeft">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="שורות הבדיקה" FontWeight="Bold"
                               Margin="8,8,8,4" Foreground="#555555" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="nav_panel" Margin="4" />
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="1" Grid.Column="1" Background="Gray" Width="1" />

                <Grid Grid.Row="1" Grid.Column="2" Margin="4">
                    <Frame x:Name="main_frame" NavigationUIVisibility="Hidden"
                           Navigated="main_frame_Navigated" />
                    <TextBlock x:Name="empty_hint" Foreground="Gray"
                               TextWrapping="Wrap" MaxWidth="440"
                               FlowDirection="RightToLeft"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed" />
                </Grid>

                <!-- Status line -->
                <Border Grid.Row="2" Grid.ColumnSpan="3" BorderThickness="0,1,0,0"
                        BorderBrush="Gray">
                    <Grid Margin="10,6,10,6" FlowDirection="RightToLeft">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="status_text"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Grid.Column="1" Content="סגור"
                                Style="{StaticResource TextButton}"
                                ToolTip="סוגר את החלון. שום דבר שנוצר במודל שלך לא נמחק."
                                Click="close_btn_Click" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
