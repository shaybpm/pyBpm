<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BPM Visual Inspection"
        Height="720"
        Width="1000"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <Grid FlowDirection="RightToLeft" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: the headline - the model's score and when it was measured -->
        <Border Grid.Row="0" Margin="4" Padding="12" BorderBrush="Gray" BorderThickness="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="ציון המודל" FontSize="12" Foreground="Gray"/>
                    <TextBlock x:Name="model_score_text" Text="—" FontSize="34" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="comp_model_text" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="run_date_text" Foreground="Gray" Margin="0,2,0,0"/>
                    <TextBlock x:Name="source_note_text" Foreground="DarkOrange" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" x:Name="refresh_btn" Content="רענן" Width="90" Padding="8,4"
                        VerticalAlignment="Center" Click="refresh_btn_Click"/>
            </Grid>
        </Border>

        <!-- Row 1: the sheets, worst score first -->
        <Border Grid.Row="1" Margin="4" BorderBrush="Gray" BorderThickness="2">
            <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <StackPanel x:Name="rows_panel"/>
            </ScrollViewer>
        </Border>

        <!-- Row 2: what the last action did -->
        <Grid Grid.Row="2" Margin="4,6,4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="status_text" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Content="סגור" Width="90" Padding="8,4" Click="close_btn_Click"/>
        </Grid>

    </Grid>
</Window>
